# Cabeçalhos para Netlify e Cloudflare Pages.
# Na Vercel, use vercel.json ou os headers do next.config.ts.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Assets versionados pelo build: cache agressivo é seguro.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# O card de compartilhamento é gerado sem extensão pelo Next.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400
