# ---------------------------------------------------------------------
# Rastreamento de conversões (opcional — o site funciona sem nenhum ID)
# Copie para .env.local e preencha antes de iniciar as campanhas.
# ---------------------------------------------------------------------

# Google Analytics 4 — ex.: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Ads — ex.: AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Rótulo da ação de conversão do Google Ads — ex.: AbCdEfGhIj12345
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Meta (Facebook/Instagram) Pixel — ex.: 1234567890123456
NEXT_PUBLIC_META_PIXEL_ID=
